{
  "name": "@garau/swatches",
  "version": "0.1.0",
  "description": "Augusto — an open, theory-grounded colour swatch system generated from @garau/engine. Every entry carries its Garau decomposition and can be compared to any other by the same harmony engine that powers `nino harmony`. Not a Pantone/Coloro competitor — a different category: a swatch that explains itself.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "tsc -p tsconfig.json && node dist/build.js",
    "contact-sheet": "tsc -p tsconfig.json && node dist/contactSheet.js"
  },
  "license": "MIT",
  "dependencies": {
    "@garau/engine": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
