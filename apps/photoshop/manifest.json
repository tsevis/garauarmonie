{
  "manifestVersion": 5,
  "id": "com.garauarmonie.transparency",
  "name": "Garau Transparency",
  "version": "0.2.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "garauTransparencyPanel",
      "label": { "default": "Garau Transparency" },
      "minimumSize": { "width": 260, "height": 360 },
      "maximumSize": { "width": 1200, "height": 2000 },
      "preferredDockedSize": { "width": 360, "height": 680 },
      "preferredFloatingSize": { "width": 380, "height": 720 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "plugin"
  }
}
